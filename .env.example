# Bot daily_vini_report. Scopes: chat:write, files:write, im:write.
SLACK_BOT_TOKEN=

# Your Slack member id (starts with U). Test pictures and the "Sent" note go here.
SLACK_NOTIFY_USER_ID=

# #central-analytics-programs. Stored only. Not used while POST_TO_CENTRAL is false.
SLACK_CHANNEL_ID=C0AULQ5F2D6

# Leave this false. The word true is what sends the 6:00 AM picture to the central channel.
POST_TO_CENTRAL=false
